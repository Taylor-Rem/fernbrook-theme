<div
  class="fb-why"
  data-fb-no-auto
  style="
    --why-bg: {{ section.settings.background_color }};
    --why-text: {{ section.settings.text_color }};
    --why-card-bg: {{ section.settings.card_background_color }};
    --why-accent: {{ section.settings.accent_color }};
  "
>
  <div class="fb-why__inner">
    <div class="fb-why__header">
      {% if section.settings.heading != blank %}
        <h2 class="fb-why__heading" data-fb-reveal>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <p class="fb-why__intro" data-fb-reveal style="--fb-delay: 90ms;">{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    <div class="fb-why__grid">
      {% for block in section.blocks %}
        <div
          class="fb-why__card"
          data-fb-reveal="scale"
          style="--fb-delay: {{ forloop.index0 | times: 110 }}ms;"
          {{ block.shopify_attributes }}
        >
          <span class="fb-why__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'leaf' %}
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M26 6C15 6 7 12 6 22c0 2 .5 3.5 1 4 6-10 13-13 13-13S10 18 8.6 26.4c1 .4 2.2.6 3.4.6 10 0 14-9 14-21Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                </svg>
              {% when 'shield' %}
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M16 3 5 7v8c0 7 4.5 11.5 11 14 6.5-2.5 11-7 11-14V7L16 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="m11 15.5 3.5 3.5 6.5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'label' %}
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="7" y="4" width="18" height="24" rx="2.5" stroke="currentColor" stroke-width="2"/>
                  <path d="M11 10h10M11 15h10M11 20h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              {% when 'drop' %}
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M16 3s9 10.2 9 17a9 9 0 1 1-18 0c0-6.8 9-17 9-17Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="M12 20a4 4 0 0 0 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              {% when 'sun' %}
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="16" cy="16" r="6" stroke="currentColor" stroke-width="2"/>
                  <path d="M16 3v3M16 26v3M3 16h3M26 16h3M6.8 6.8l2.1 2.1M23.1 23.1l2.1 2.1M25.2 6.8l-2.1 2.1M8.9 23.1l-2.1 2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              {% else %}
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="2"/>
                  <path d="m11 16 3.5 3.5L21.5 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            {% endcase %}
          </span>
          {% if block.settings.heading != blank %}
            <h3 class="fb-why__card-heading">{{ block.settings.heading }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="fb-why__card-text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .fb-why {
    background-color: var(--why-bg);
    color: var(--why-text);
  }

  .fb-why__inner {
    width: min(1160px, 100% - 2.5rem);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
  }

  .fb-why__header {
    max-width: 36rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
  }

  .fb-why__heading {
    margin: 0;
    font-family: var(--font-h2--family);
    font-weight: var(--font-h2--weight);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .fb-why__intro {
    margin: 1rem 0 0;
    line-height: 1.6;
    opacity: 0.8;
  }

  .fb-why__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .fb-why__card {
    background-color: var(--why-card-bg);
    border: 1px solid rgb(from var(--why-text) r g b / 0.12);
    border-radius: 14px;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    transition:
      translate 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .fb-why__card:hover {
    translate: 0 -6px;
    box-shadow: 0 18px 40px -22px rgb(from var(--why-text) r g b / 0.45);
  }

  .fb-why__icon {
    display: inline-flex;
    width: 46px;
    height: 46px;
    padding: 10px;
    border-radius: 50%;
    color: var(--why-accent);
    background-color: rgb(from var(--why-accent) r g b / 0.12);
  }

  .fb-why__icon svg {
    width: 100%;
    height: 100%;
  }

  .fb-why__card-heading {
    margin: 1.1rem 0 0;
    font-family: var(--font-h4--family);
    font-weight: var(--font-h4--weight);
    font-size: 1.15rem;
  }

  .fb-why__card-text {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .fb-why__card,
    .fb-why__card:hover {
      translate: none;
      transition: none;
    }
  }

  @media screen and (max-width: 899px) {
    .fb-why__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why Fernbrook",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Fernbrook"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Simple formulas, honest sourcing, and testing we publish. That is the whole pitch."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "{{ settings.color_palette.color2 }}"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icon accent",
      "default": "#C96F4A"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield check" },
            { "value": "label", "label": "Label" },
            { "value": "drop", "label": "Drop" },
            { "value": "sun", "label": "Sun" },
            { "value": "check", "label": "Check circle" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Sourced with care"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Single-origin botanicals and minerals from suppliers we know by name."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Why Fernbrook",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "heading": "Sourced with care",
            "text": "Single-origin botanicals and minerals from suppliers we know by name."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "heading": "Third-party tested",
            "text": "Every batch is verified for identity and purity by an independent lab."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "label",
            "heading": "Plain-spoken labels",
            "text": "What is in the bottle, in words you do not need a chemistry degree to read."
          }
        }
      ]
    }
  ]
}
{% endschema %}
